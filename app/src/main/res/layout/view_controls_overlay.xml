<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewControlsOverlay"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:layout_margin="8dp"
    android:orientation="vertical"
    android:background="@drawable/overlay_background"
    android:padding="4dp">

    <ImageButton
        android:id="@+id/btnViewTop"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Top view"
        android:src="@drawable/ic_view_top"
        android:scaleType="centerInside"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/btnViewFront"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Front view"
        android:src="@drawable/ic_view_front"
        android:scaleType="centerInside"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/btnViewLeft"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Left view"
        android:src="@drawable/ic_view_left"
        android:scaleType="centerInside"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/btnViewRight"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Right view"
        android:src="@drawable/ic_view_right"
        android:scaleType="centerInside"
        app:tint="@color/white" />

</LinearLayout>
