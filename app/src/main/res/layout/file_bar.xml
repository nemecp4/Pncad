<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fileBar"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:background="@color/code_background"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- File Menu icon button -->
    <ImageButton
        android:id="@+id/btnFileMenu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="File menu"
        android:src="@android:drawable/ic_menu_agenda"
        android:scaleType="centerInside"
        app:tint="@color/white" />

    <!-- Open Files Menu icon button -->
    <ImageButton
        android:id="@+id/btnOpenFilesMenu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Open files"
        android:src="@android:drawable/ic_menu_sort_by_size"
        android:scaleType="centerInside"
        app:tint="@color/white" />

</LinearLayout>
