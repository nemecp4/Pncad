<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash icon: an isometric cube outline, evoking a 3D CAD model.
  Drawn on a 108x108 canvas (adaptive-icon viewport) so the splash API
  scales and masks it consistently with the launcher icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top face -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35"
        android:pathData="M54,26 L80,40 L54,54 L28,40 Z" />

    <!-- Left face -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.7"
        android:pathData="M28,40 L54,54 L54,82 L28,68 Z" />

    <!-- Right face -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M80,40 L54,54 L54,82 L80,68 Z" />

    <!-- Cube outline -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:strokeLineJoin="round"
        android:pathData="M54,26 L80,40 L80,68 L54,82 L28,68 L28,40 Z M54,26 L54,54 M28,40 L54,54 L80,40" />

</vector>
